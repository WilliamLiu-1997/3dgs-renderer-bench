# The site build (tools/build-site.mjs) needs lab/, report/, the READMEs and the
# published report captures in harness/results/*.png. Everything else stays local.
harness/*
!harness/README.md
!harness/results/
harness/results/*
!harness/results/*.png
vendor/*
!vendor/playcanvas-2.24.0-beta.30.tgz
!vendor/sparkjsdev-radix-0.0.1.tgz
licenses/
models/
.venv/
outputs/
release/
site/
tools/*.py
tools/requirements.txt
tools/report_template.html
