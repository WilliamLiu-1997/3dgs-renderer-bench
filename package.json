{
  "name": "3dgs-renderer-bench",
  "version": "1.0.0",
  "private": true,
  "description": "Measured 3D Gaussian Splatting renderer comparisons and reproduction harness",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build-site.mjs",
    "dev": "node tools/dev-server.mjs"
  },
  "dependencies": {
    "@playcanvas/splat-transform": "3.6.4",
    "@sparkjsdev/spark": "2.2.0",
    "gaussian-splat-lite": "1.1.5",
    "jspdf": "4.2.1",
    "playcanvas": "2.23.0-beta.20",
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.55.1"
  },
  "overrides": {
    "@playcanvas/splat-transform": {
      "playcanvas": "$playcanvas"
    }
  },
  "engines": {
    "node": "22.x || 24.x"
  }
}
