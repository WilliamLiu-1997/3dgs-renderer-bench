{
  "name": "3dgs-renderer-bench",
  "version": "1.0.0",
  "private": true,
  "description": "Measured 3D Gaussian Splatting renderer comparisons and reproduction harness",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "build": "node tools/build-site.mjs",
    "bench:build": "node harness/build.mjs",
    "bench:serve": "node harness/server.mjs",
    "bench:pilot": "node harness/run.mjs --pilot --variants",
    "bench": "node harness/run.mjs",
    "bench:sort": "node harness/run-sort.mjs",
    "report": ".venv/bin/python tools/report.py",
    "report:publish": ".venv/bin/python tools/report.py --publish",
    "format": "prettier --write . && .venv/bin/ruff format tools",
    "lint": "prettier --check . && .venv/bin/ruff check tools && .venv/bin/ruff format --check tools"
  },
  "dependencies": {
    "@playcanvas/splat-transform": "3.6.4",
    "@playcanvas/supersplat-viewer": "1.42.0",
    "@sparkjsdev/radix": "file:vendor/sparkjsdev-radix-0.0.1.tgz",
    "@sparkjsdev/spark": "2.4.0",
    "gaussian-splat-lite": "1.6.2",
    "jspdf": "4.2.1",
    "playcanvas": "file:vendor/playcanvas-2.24.0-beta.30.tgz",
    "three": "0.187.0",
    "three-radix": "npm:three@0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.55.1",
    "prettier": "3.3.3"
  },
  "overrides": {
    "@playcanvas/splat-transform": {
      "playcanvas": "$playcanvas"
    },
    "@playcanvas/supersplat-viewer": {
      "playcanvas": "$playcanvas"
    }
  },
  "engines": {
    "node": "22.x || 24.x"
  }
}
